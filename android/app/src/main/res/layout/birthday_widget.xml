<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_lavender">
  <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:padding="8dp">
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
      <TextView android:id="@+id/widget_prev" android:layout_width="24dp" android:layout_height="24dp" android:textSize="18sp" android:includeFontPadding="false" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:text="‹" android:contentDescription="Önceki kayıt" />
      <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="start|center_vertical" android:layout_weight="1">
        <TextView android:id="@+id/widget_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="20sp" android:includeFontPadding="false" android:gravity="center" android:singleLine="false" android:ellipsize="end" android:textStyle="bold" android:textAlignment="viewStart" android:maxLines="2" />
        <TextView android:id="@+id/kind" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:includeFontPadding="false" android:gravity="center" android:singleLine="false" android:ellipsize="end" android:textAlignment="viewStart" android:maxLines="2" />
        <TextView android:id="@+id/widget_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:includeFontPadding="false" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/badge_special" />
      </LinearLayout>
      <LinearLayout android:orientation="vertical" android:layout_width="60dp" android:layout_height="wrap_content" android:id="@+id/nav" android:gravity="center">
        <TextView android:id="@+id/dots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:includeFontPadding="false" android:gravity="center" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/art" android:layout_width="54dp" android:layout_height="wrap_content" android:textSize="36sp" android:includeFontPadding="false" android:gravity="center" android:singleLine="true" android:ellipsize="end" />
      </LinearLayout>
      <TextView android:id="@+id/widget_next" android:layout_width="24dp" android:layout_height="24dp" android:textSize="18sp" android:includeFontPadding="false" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:text="›" android:contentDescription="Sonraki kayıt" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_actions" android:layout_marginTop="4dp">
      <TextView android:id="@+id/widget_call" android:layout_width="0dp" android:layout_height="28dp" android:textSize="13sp" android:includeFontPadding="false" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:layout_weight="1" android:text="☎  Ara" android:textColor="#FFFFFF" android:layout_marginEnd="5dp" />
      <TextView android:id="@+id/widget_chat" android:layout_width="0dp" android:layout_height="28dp" android:textSize="13sp" android:includeFontPadding="false" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:layout_weight="1" android:text="WhatsApp" android:textColor="#18563C" android:background="@drawable/widget_chat_pill" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>